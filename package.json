{
  "name": "neon-survival",
  "version": "0.1.0",
  "private": true,
  "description": "Endless retro-pixel arcade survival game for the browser",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server",
    "server:dev": "wrangler dev --config server/wrangler.toml --port 8787",
    "server:loadtest": "node server/scripts/loadtest.mjs",
    "server:smoke": "node server/scripts/smoke.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261125.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "^4.168.0"
  }
}
